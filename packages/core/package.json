{
  "name": "@rps/core",
  "version": "0.1.0",
  "description": "Schema, validation, and layout calculation for Research Poster Studio (DOM/Electron-free)",
  "license": "Apache-2.0",
  "author": "Yuki Inoue Nakata <dj.y.nakata@gmail.com>",
  "homepage": "https://github.com/YukiInoueNakata/research_poster_studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YukiInoueNakata/research_poster_studio.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/YukiInoueNakata/research_poster_studio/issues"
  },
  "keywords": [
    "academic-poster",
    "poster",
    "layout",
    "yaml",
    "research"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "js-yaml": "^4.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "~5.8.3"
  }
}
