{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Research Poster Studio",
  "version": "0.1.1",
  "identifier": "io.github.yukiinouenakata.research-poster-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Research Poster Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Yuki Inoue Nakata",
    "copyright": "Copyright 2026 Yuki Inoue Nakata and the Research Poster Studio contributors",
    "license": "Apache-2.0",
    "homepage": "https://github.com/YukiInoueNakata/research_poster_studio",
    "category": "Productivity",
    "shortDescription": "Structured layout editor for academic research posters",
    "longDescription": "Research Poster Studio lays out A0/A1 academic posters from YAML + Markdown + BibTeX with columns, blocks and height modes, previews them at real size, warns about overflow, and exports PDF, PNG, HTML, SVG, PPTX and Marp.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../examples/sample-cat-paws-en/": "examples/sample-cat-paws-en/",
      "../../../examples/sample-cat-paws-ja/": "examples/sample-cat-paws-ja/",
      "../../../LICENSE": "LICENSE",
      "../../../NOTICE": "NOTICE",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    }
  }
}
