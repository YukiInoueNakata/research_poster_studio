{
  "name": "@rps/renderer",
  "version": "0.1.0",
  "description": "Render a poster project to self-contained HTML / SVG / Marp (shared by desktop, CLI, VS Code)",
  "license": "Apache-2.0",
  "author": "Yuki Inoue Nakata <dj.y.nakata@gmail.com>",
  "homepage": "https://github.com/YukiInoueNakata/research_poster_studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YukiInoueNakata/research_poster_studio.git",
    "directory": "packages/renderer"
  },
  "bugs": {
    "url": "https://github.com/YukiInoueNakata/research_poster_studio/issues"
  },
  "keywords": [
    "academic-poster",
    "poster",
    "renderer",
    "markdown",
    "svg"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rps/core": "^0.1.0",
    "isomorphic-dompurify": "^2.16.0",
    "marked": "^18.0.5",
    "mathjax-full": "^3.2.1",
    "qrcode-generator": "^2.0.4"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.3.0",
    "typescript": "~5.8.3"
  }
}
