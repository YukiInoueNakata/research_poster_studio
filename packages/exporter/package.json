{
  "name": "@rps/exporter",
  "version": "0.1.0",
  "description": "Render self-contained poster HTML to PDF / PNG via Playwright (A0/A1 @page)",
  "license": "Apache-2.0",
  "author": "Yuki Inoue Nakata <dj.y.nakata@gmail.com>",
  "homepage": "https://github.com/YukiInoueNakata/research_poster_studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YukiInoueNakata/research_poster_studio.git",
    "directory": "packages/exporter"
  },
  "bugs": {
    "url": "https://github.com/YukiInoueNakata/research_poster_studio/issues"
  },
  "keywords": [
    "academic-poster",
    "poster",
    "pdf",
    "playwright",
    "export"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "~5.8.3"
  }
}
